# Environment Variables for StationTalk
# Copy this file to .env.local and fill in your LiveKit Cloud credentials.
#
# Get your credentials at: https://cloud.livekit.io
#
# NEVER commit .env.local or any file containing real secrets.

# LiveKit API Key (from LiveKit Cloud dashboard)
LIVEKIT_API_KEY=your_api_key_here

# LiveKit API Secret (from LiveKit Cloud dashboard)
LIVEKIT_API_SECRET=your_api_secret_here

# LiveKit WebSocket URL (e.g., wss://your-project.livekit.cloud)
# This is prefixed with NEXT_PUBLIC_ because the client needs it to connect.
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# Supabase (Optional: for persistent subscription tracking across cold starts)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay (For Premium subscription matching)
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret
